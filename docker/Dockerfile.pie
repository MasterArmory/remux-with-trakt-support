FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p remux-server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/remux-server /app/remux-server
COPY dashboard /app/dashboard
ENV DASHBOARD_PATH=/app/dashboard
ENV WEB_PATH=/app/dashboard
ENV DATA_DIR=/data
ENV PORT=3000
ENV DISABLE_DHT=true
EXPOSE 3000
VOLUME /data
ENTRYPOINT ["/app/remux-server"]
CMD ["--datadir", "/data", "--port", "3000"]
